<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AndroidWithKotlin.textview.Textview">

    <TextView
        android:id="@+id/textViewId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#ff0000"
        android:ellipsize="end"
        android:padding="30dp"
        android:singleLine="true"
        android:text="Hello Worldfsdfsfdsfsfdasdadadadsda!"
        android:textAllCaps="true"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textviewId2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:onClick="onClick"
        android:padding="30dp"
        android:shadowColor="#FFBB86FC"
        android:shadowDx="6"
        android:shadowDy="6"
        android:shadowRadius="2"
        android:text="Hello Tutorialwing! Shadow in Text"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewId" />

    <TextView
        android:id="@+id/textviewId3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoLink="all"
        android:gravity="center_horizontal"
        android:linksClickable="true"
        android:text="Hello URL: https://www.youtube.com/watch?v=yHyc-IZ_OQc"
        android:textColor="@color/black"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/textviewId2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textviewId4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hello url https://www.tutorialwing.com"
        android:layout_margin="20dp"
        android:gravity="center"
        android:drawablePadding="10dp"
        app:layout_constraintTop_toBottomOf="@id/textviewId3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:drawableEndCompat="@mipmap/ic_launcher_round"
        app:drawableStartCompat="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/spanText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/textviewId4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        android:gravity="center_horizontal"/>

</androidx.constraintlayout.widget.ConstraintLayout>